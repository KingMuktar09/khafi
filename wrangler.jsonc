// Cloudflare Workers (Static Assets) deploy for Ilm-e-Ghayb Library.
//
// This is a SECOND home for the same site. The live site stays on Vercel
// (https://ilmeghayb.vercel.app/) unless the owner decides otherwise.
// Deploying here gives a free global edge copy at
// https://ilmeghayb.<your-subdomain>.workers.dev
//
// Deploy (free Cloudflare account, no custom domain needed):
//   1. npm run build
//   2. npx wrangler login
//   3. npx wrangler deploy
//
// Secrets are NEVER in this file. Set them in the Cloudflare dashboard
// (Workers & Pages > ilmeghayb > Settings > Variables) or with:
//   npx wrangler secret put ADMIN_USERNAME
//   npx wrangler secret put ADMIN_PASSWORD
//   npx wrangler secret put SESSION_SECRET
//   npx wrangler secret put GOOGLE_SERVICE_ACCOUNT_EMAIL
//   npx wrangler secret put GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY
//   npx wrangler secret put GOOGLE_DRIVE_FOLDER_ID
//   npx wrangler secret put CRON_SECRET
// Without them the worker serves the bundled catalog (36 folders, 173 books)
// and books open in Google Drive, exactly like the Vercel catalog-links mode.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ilmeghayb",
  "main": "dist/_worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Daily auto-sync of the catalog from Google Drive, 02:00 UTC.
  // Runs only when CRON_SECRET is set as a secret; the worker's scheduled
  // handler calls its own /api/cron/sync endpoint with that secret.
  // Free plan allows daily cron triggers. Remove this block to disable it.
  "triggers": {
    "crons": [
      "0 2 * * *"
    ]
  }
}
