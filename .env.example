# Khafi Library Environment Configuration Example
# Copy this file to .env or configure in your deployment platform

# Admin Credentials
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
SESSION_SECRET=""

# Google Drive Storage Integration
GOOGLE_DRIVE_SHARED_DRIVE_ID=""
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# NVIDIA NIM AI Library Organizer (Server-Side ONLY)
# TWO SEPARATE API KEYS:
# 1. NVIDIA_MUSE_API_KEY for meta/muse-glimmer-30b (Reasoning & Classification)
# 2. NVIDIA_EMBEDDING_API_KEY for nvidia/nemotron-3-embed-1b (Embeddings & Semantic Similarity)
NVIDIA_MUSE_API_KEY=""
NVIDIA_EMBEDDING_API_KEY=""
NVIDIA_API_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MUSE_MODEL="meta/muse-glimmer-30b"
NVIDIA_EMBEDDING_MODEL="nvidia/nemotron-3-embed-1b"
