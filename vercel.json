{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "data/catalog.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__path=$1"
    },
    {
      "source": "/((?!api/|uploads/|sample-pdfs/|assets/|favicon.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
