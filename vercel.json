{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "data/catalog.json",
      "regions": ["bom1"]
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__path=$1"
    },
    {
      "source": "/((?!api/|uploads/|sample-pdfs/|assets/|favicon.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
